# SPDX-License-Identifier: Apache-2.0

export DH_VERBOSE = 1
export CGO_ENABLED = 0
export GOFLAGS = -buildvcs=false -mod=readonly

%:
	dh $@

# Debian exports C/C++ hardening LDFLAGS (e.g. -Wl,-z,relro) that must not
# reach the Go linker.
override_dh_auto_build:
	env -u LDFLAGS $(MAKE) build

# The unit suite runs in the dev container; the packaging build only compiles.
override_dh_auto_test:
	:

override_dh_auto_install:
	install -D -m 0755 bin/knarr debian/knarr/usr/bin/knarr
	bin/knarr completion bash > knarr.bash
	install -D -m 0644 knarr.bash debian/knarr/usr/share/bash-completion/completions/knarr
	bin/knarr completion zsh > knarr.zsh
	install -D -m 0644 knarr.zsh debian/knarr/usr/share/zsh/vendor-completions/_knarr

override_dh_auto_clean:
	rm -rf bin knarr.bash knarr.zsh

# The binary is already stripped (-s -w); there is no DWARF for dwz.
override_dh_dwz:
	:
