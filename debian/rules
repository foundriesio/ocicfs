# SPDX-License-Identifier: Apache-2.0

export DH_VERBOSE = 1
export CGO_ENABLED = 0
export GOFLAGS = -buildvcs=false -mod=readonly

%:
	dh $@

# Debian exports C/C++ hardening LDFLAGS (e.g. -Wl,-z,relro) that must not
# reach the Go linker.
override_dh_auto_build:
	env -u LDFLAGS $(MAKE) build

# The unit suite runs in the dev container; the packaging build only compiles.
override_dh_auto_test:
	:

override_dh_auto_install:
	install -D -m 0755 bin/ocicfs debian/ocicfs/usr/bin/ocicfs
	bin/ocicfs completion bash > ocicfs.bash
	install -D -m 0644 ocicfs.bash debian/ocicfs/usr/share/bash-completion/completions/ocicfs
	bin/ocicfs completion zsh > ocicfs.zsh
	install -D -m 0644 ocicfs.zsh debian/ocicfs/usr/share/zsh/vendor-completions/_ocicfs

override_dh_auto_clean:
	rm -rf bin ocicfs.bash ocicfs.zsh

# The binary is already stripped (-s -w); there is no DWARF for dwz.
override_dh_dwz:
	:
