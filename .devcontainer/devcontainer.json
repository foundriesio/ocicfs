{
  "name": "ocicfs",
  "build": {
    "dockerfile": "../Containerfile",
    "context": ".."
  },
  "runArgs": [
    "--privileged"
  ],
  "containerEnv": {
    "OCICFS_TEST_VERITY_SIZE_MB": "${localEnv:OCICFS_TEST_VERITY_SIZE_MB}"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/bin"
  },
  "postStartCommand": "/usr/local/bin/dev-entrypoint",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ]
    }
  }
}
